[Unit]
Description=RSS Service Daemon
After=network.target

[Service]
# The daemon has no authentication; behind the web app it only
# needs local connections. To serve other hosts, remove
# --bind 127.0.0.1 below or give another address -- the program's
# own default, when no --bind is given, is 0.0.0.0.
ExecStart=/usr/local/bin/rsswitchd --bind 127.0.0.1
Type=simple
# Runs as the unprivileged system user make install creates.
User=rsswitchd
# Raspberry Pi OS gives this group access to /dev/gpiochip*; on a
# BeagleBone Black, the image's udev rules must give it write
# access to /sys/class/gpio instead.
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
