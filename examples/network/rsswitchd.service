[Unit]
Description=RSS Service Daemon
# An ExecStart edited to bind a LAN address needs that address to
# exist, and DHCP may assign it after network.target. Without the wait
# the start at boot fails 5 times and the unit stays failed. With
# --bind 127.0.0.1 this changes nothing.
After=network.target network-online.target
# Wants= pulls network-online.target in; After= alone would only order
# the unit behind it when something else happens to start it.
Wants=network-online.target
# A start that keeps failing, for example because another program holds
# the port or because an edited ExecStart has a malformed --gpio (both
# exit status 1), or an option that the daemon refuses (exit status 2),
# is tried 5 times within 60 seconds. Then systemd gives up and the unit is failed. The default of
# systemd, 5 starts within 10 seconds, is never reached with
# RestartSec=2 below, because the starts are more than 2 seconds apart,
# so without these lines the daemon would restart forever.
StartLimitIntervalSec=60
# The 5 starts are the default of systemd, written out next to the
# interval they belong to.
StartLimitBurst=5

[Service]
# The daemon has no authentication; behind the web app it only
# needs local connections. To serve other hosts, remove
# --bind 127.0.0.1 below or give another address -- the program's
# own default, when no --bind is given, is 0.0.0.0.
# --gpio chip:line selects another GPIO line, e.g. --gpio gpiochip0:17;
# without it the daemon uses the default line of its board.
ExecStart=/usr/local/bin/rsswitchd --bind 127.0.0.1
Type=simple
# Runs as the unprivileged system user make install creates.
User=rsswitchd
# libgpiod opens /dev/gpiochip* on both boards, so this group needs
# read and write access to it. Raspberry Pi OS and the BeagleBoard.org
# Debian images grant that with a udev rule. On another image, add the
# rule shown in examples/network/README.md.
SupplementaryGroups=gpio
# The daemon can never gain privileges, e.g. via setuid binaries.
NoNewPrivileges=yes
# Read-only file system, except the API file systems /dev, /proc
# and /sys, which GPIO access needs.
ProtectSystem=strict
# Home directories are not visible.
ProtectHome=yes
# A private /tmp.
PrivateTmp=yes
# Restart after a crash.
Restart=on-failure
# A failing start does not spin, e.g. when the port is in use.
RestartSec=2
# PrivateDevices= and DevicePolicy= are left out on purpose: both
# would hide /dev/gpiochip*, which libgpiod needs on both boards.

[Install]
WantedBy=multi-user.target
