[Unit]
Description=RSS Service Daemon
After=network.target
# A start that keeps failing, for example because another program holds
# the port (exit status 1) or because an edited ExecStart has an option
# that the daemon refuses (exit status 2), is tried 5 times within 60
# seconds. Then systemd gives up and the unit is failed. The default of
# systemd, 5 starts within 10 seconds, is never reached with
# RestartSec=2 below, because the starts are more than 2 seconds apart,
# so without these lines the daemon would restart forever.
StartLimitIntervalSec=60
# The 5 starts are the default of systemd, written out next to the
# interval they belong to.
StartLimitBurst=5

[Service]
# The daemon has no authentication; behind the web app it only
# needs local connections. To serve other hosts, remove
# --bind 127.0.0.1 below or give another address -- the program's
# own default, when no --bind is given, is 0.0.0.0.
ExecStart=/usr/local/bin/rsswitchd --bind 127.0.0.1
Type=simple
# Runs as the unprivileged system user make install creates.
User=rsswitchd
# Raspberry Pi OS gives this group access to /dev/gpiochip*; on a
# BeagleBone Black, the image's udev rules must give it write
# access to /sys/class/gpio instead.
SupplementaryGroups=gpio
# The daemon can never gain privileges, e.g. via setuid binaries.
NoNewPrivileges=yes
# Read-only file system, except the API file systems /dev, /proc
# and /sys, which GPIO access needs.
ProtectSystem=strict
# Home directories are not visible.
ProtectHome=yes
# A private /tmp.
PrivateTmp=yes
# Restart after a crash.
Restart=on-failure
# A failing start does not spin, e.g. when the port is in use.
RestartSec=2
# PrivateDevices=, DevicePolicy= and ProtectKernelTunables= are left
# out on purpose: the first two would hide /dev/gpiochip*, which
# libgpiod needs on the Raspberry Pi, and the last would make /sys
# read-only, which breaks sysfs GPIO on the BeagleBone.

[Install]
WantedBy=multi-user.target
