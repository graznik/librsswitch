[Unit]
Description=rsswitch-web, web UI for rsswitchd
# The app switches sockets through rsswitchd, so it starts after it and
# pulls it in. It does not require it: the app starts and reports
# "rsswitchd unreachable" for a switch while the daemon is down.
After=network.target rsswitchd.service
Wants=rsswitchd.service

[Service]
Type=simple
# Runs as the unprivileged system user make install creates. This user
# is in no other group; the app does not touch GPIO, rsswitchd does.
User=rsswitch-web
# python -m finds the package through the working directory, and the
# default working directory of systemd is /.
WorkingDirectory=/opt/rsswitch-web
# serve runs the app under waitress. The venv python is the one that
# has Flask and waitress installed.
ExecStart=/opt/rsswitch-web/venv/bin/python -m rsswitch_web --config /etc/rsswitch-web/config.json serve
# Creates /var/lib/rsswitch-web for the user, which stays writable
# although ProtectSystem=strict makes the rest of the tree read-only.
StateDirectory=rsswitch-web
# The data file is for this user only.
StateDirectoryMode=0750
# Files that the app creates are not readable by anybody else.
UMask=0077
# The app can never gain privileges, e.g. via setuid binaries.
NoNewPrivileges=yes
# Read-only file system, except the state directory above.
ProtectSystem=strict
# Home directories are not visible.
ProtectHome=yes
# A private /tmp.
PrivateTmp=yes
# The app needs no device. rsswitchd owns the GPIO lines.
PrivateDevices=yes
# The app has no reason to change kernel tunables.
ProtectKernelTunables=yes
# The app has no reason to load kernel modules.
ProtectKernelModules=yes
# The app has no reason to change control groups.
ProtectControlGroups=yes
# The app does not switch the execution domain.
LockPersonality=yes
# TCP to rsswitchd and from the phones. AF_UNIX is for the name
# service when daemon_host is a name.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The app needs no capability at all. Port 1024 and above need none.
CapabilityBoundingSet=
# The app creates no namespace.
RestrictNamespaces=yes
# The app creates no setuid or setgid file.
RestrictSUIDSGID=yes
# The app needs no real-time scheduling.
RestrictRealtime=yes
# The app does not set the system clock.
ProtectClock=yes
# The app does not read the kernel log.
ProtectKernelLogs=yes
# The app does not change the host name.
ProtectHostname=yes
# The app sees the processes of its own user only, and none of them
# other than its own.
ProtectProc=invisible
# The app reads nothing in /proc except the process entries.
ProcSubset=pid
# No system call of a foreign ABI, such as 32-bit code on aarch64.
SystemCallArchitectures=native
# The calls of a normal service ...
SystemCallFilter=@system-service
# ... without the privileged ones and the ones that change resource
# limits, which a Python web app never uses.
SystemCallFilter=~@privileged @resources
# Restart after a crash.
Restart=on-failure
# A failing start does not spin, e.g. when the port is in use.
RestartSec=2

[Install]
WantedBy=multi-user.target
